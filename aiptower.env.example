# =============================================================================
# AIP-Tower 密钥（复制为 aiptower.env，勿提交 Git）
#
#   cp aiptower.env.example aiptower.env
#
# 地址、端口、用户名见 application-{profile}.yaml
# Docker：cd script/docker && docker compose --env-file ../../aiptower.env ...
#
# IDE（IntelliJ）：
#   1. 安装插件 EnvFile
#   2. Run Configuration → AiptowerServerApplication → EnvFile 页签
#   3. 勾选 Enable EnvFile → 点 + 添加本文件（类型选 .env，Executable 勿勾选）
#   4. Active profiles 留空（由下方 SPRING_PROFILES_ACTIVE 指定）
# =============================================================================

# 运行环境：local | dev | test
SPRING_PROFILES_ACTIVE=local

# PostgreSQL（application-{profile}.yaml 中的 ${DB_PASSWORD}）
DB_PASSWORD=4j0tmspsjl95rtds

# Redis（application-{profile}.yaml 中的 ${REDIS_PASSWORD}）
REDIS_PASSWORD=
